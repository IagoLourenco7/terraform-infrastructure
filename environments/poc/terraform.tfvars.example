aws_region  = "us-east-1"
environment = "poc"
domain_name = "customers"

domain_analysts = [
  "analyst1",
  "analyst2"
]

# ARNs de quem pode assumir as roles de owner/analyst/pipeline deste domínio
trusted_principal_arns = [
  "arn:aws:iam::123456789012:user/seu-usuario-aws"
]

